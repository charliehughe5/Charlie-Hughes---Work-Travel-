# =================================================================
# Charlie Creator Hub — Environment Variables Specification
# =================================================================

# 1. Gemini AI API (Required for Scripts, Ideation, Research & Veo)
# Automatically injected by AI Studio when configured in Secrets panel
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Host Application URL
# Automatically injected by AI Studio at runtime
APP_URL="https://ais-dev-2so7xc2obvsz3hdv67uumd-980345766353.europe-west2.run.app"

# 3. Creator Workspace Owner Security
# Private authentication PIN/password for Charlie Hughes owner access
OWNER_PIN="2026"
SESSION_SECRET="charlie-creator-hub-secure-session-key-2026"

# 4. YouTube Data API v3 & YouTube Analytics API (Google OAuth 2.0)
# Configure in Google Cloud Console -> APIs & Services -> Credentials
# Redirect URI: <APP_URL>/api/auth/youtube/callback
YOUTUBE_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 5. Google Ads API
# Requires approved Google Ads Developer Token and linked manager/customer account
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""

# 6. Video Generation (Veo)
VEO_MODEL_NAME="veo-3.1-lite-generate-preview"
